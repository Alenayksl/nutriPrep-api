PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nutriprep?schema=public"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="1h"
ADMIN_EMAIL="admin@nutriprep.local"
ADMIN_PASSWORD="admin-password-change-me"
REFRESH_TOKEN_EXPIRES_DAYS="30"
OAUTH_WEB_CLIENT_ID="nutriprep-web"
OAUTH_SERVICE_CLIENT_ID="nutriprep-service"
OAUTH_SERVICE_CLIENT_SECRET="replace-with-a-long-random-client-secret"
